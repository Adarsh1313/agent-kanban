{
  "name": "agent-kanban",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:web",
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "desktop": "node scripts/desktop/start.mjs",
    "desktop:stop": "node scripts/desktop/stop.mjs",
    "desktop:install": "node scripts/desktop/install-shortcuts.mjs",
    "desktop:app": "npm run build:web && electron apps/desktop",
    "desktop:icons": "electron apps/desktop/scripts/make-icons.ts",
    "desktop:dist": "node --disable-warning=ExperimentalWarning apps/desktop/scripts/package.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2"
  }
}
